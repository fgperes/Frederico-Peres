// SGRH - Sistema de Gestão de Recursos Humanos
// Modelo de dados baseado no Documento Funcional SGRH v1.0

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Perfis de Acesso e Permissões (secção 4)
// ---------------------------------------------------------------------------

// Tipos de perfil. Os 6 perfis originais são semeados automaticamente (ver
// ensureMatrixLoaded em lib/roles.ts); o Administrador do Sistema pode criar,
// renomear e eliminar perfis adicionais em Perfis e Acessos → Perfis.
// isSystem protege ADMIN_SISTEMA e COLABORADOR (estruturais à aplicação) de
// serem eliminados.
model RoleDefinition {
  id          String   @id @default(cuid())
  key         String   @unique // identificador interno estável, nunca editável após criação
  label       String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  passwordHash       String
  name               String
  avatarKey          String? // referência a um avatar predefinido (ver lib/avatars.tsx)
  avatarImage        String? // foto carregada pelo próprio (data URI, redimensionada no browser); tem prioridade sobre avatarKey
  roles              UserRole[]
  employee           Employee?
  active             Boolean    @default(true)
  mustChangePassword Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  canPublishNews Boolean @default(false)

  auditLogs          AuditLog[]
  approvedAbsences   Absence[]         @relation("AbsenceApprover")
  requestedAbsences  Absence[]         @relation("AbsenceRequester")
  reviewedDeviations TimeClockEntry[]  @relation("DeviationReviewer")
  importLogs         ImportLog[]
  sentMessages       Message[]         @relation("MessageSender")
  receivedMessages   Message[]         @relation("MessageRecipient")
  tasks              Task[]            @relation("TaskAssignee")
  news               News[]            @relation("NewsAuthor")
  hoursCorrections   HoursCorrection[] @relation("HoursCorrectionCreatedBy")

  createdEvaluationTemplates EvaluationTemplate[]
  createdEvaluations         Evaluation[]         @relation("EvaluationCreatedBy")
  completedEvaluations       Evaluation[]         @relation("EvaluationCompletedBy")

  anniversaryCommentsAuthored AnniversaryComment[]

  timeClockDayDecisionsCreated TimeClockDayDecision[] @relation("TimeClockDayDecisionCreatedBy")
  hourPoolMovementsCreated     HourPoolMovement[]     @relation("HourPoolMovementCreatedBy")
  hourPoolMovementsReversed    HourPoolMovement[]     @relation("HourPoolMovementReversedBy")

  documentTemplatesCreated DocumentTemplate[]
}

// Notícias do dashboard. targetRoles vazio = visível para todos ("Todos" no
// seletor); caso contrário só é mostrada a utilizadores com pelo menos um
// dos perfis listados. notifyUsers cria uma Task tipo NEWS por destinatário.
model News {
  id          String   @id @default(cuid())
  subject     String
  bodyHtml    String
  notifyUsers Boolean  @default(false)
  targetRoles String[]
  authorId    String
  author      User     @relation("NewsAuthor", fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
}

// Tarefas atribuídas a um utilizador (ex.: gestor de RH/supervisor a
// definir o horário de refeição de um colaborador).
model Task {
  id           String      @id @default(cuid())
  title        String
  description  String?
  type         String      @default("GENERAL") // GENERAL | MEAL_BREAK_SCHEDULE
  assigneeId   String
  assignee     User        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  employeeId   String?
  employee     Employee?   @relation(fields: [employeeId], references: [id])
  evaluationId String?
  evaluation   Evaluation? @relation(fields: [evaluationId], references: [id])
  status       String      @default("OPEN") // OPEN | DONE
  createdAt    DateTime    @default(now())
  resolvedAt   DateTime?

  @@index([assigneeId, status])
}

// Mensagens rápidas entre utilizadores (barra superior).
model Message {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, readAt])
  @@index([senderId])
}

// Associa um perfil a um utilizador, com âmbito opcional (departamento)
model UserRole {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())

  @@unique([userId, role, departmentId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
}

// Substitui/complementa a matriz de acessos por omissão (lib/roles.ts) —
// só guarda desvios definidos pelo Administrador do Sistema em Perfis e
// Acessos. Perfil+módulo sem registo aqui usam o valor por omissão.
model RolePermission {
  id          String   @id @default(cuid())
  role        String
  module      String
  accessLevel String // rw | ro | none
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@unique([role, module])
}

// ---------------------------------------------------------------------------
// Gestão de Recursos (secção 5)
// ---------------------------------------------------------------------------

model Department {
  id             String           @id @default(cuid())
  name           String           @unique
  parentId       String?
  parent         Department?      @relation("DeptHierarchy", fields: [parentId], references: [id])
  children       Department[]     @relation("DeptHierarchy")
  teams          Team[]
  employees      Employee[]
  userRoles      UserRole[]
  equipment      Equipment[]
  operatingHours OperatingHours[]
  createdAt      DateTime         @default(now())
}

model Team {
  id           String     @id @default(cuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  employees    Employee[]
  createdAt    DateTime   @default(now())

  evaluationAssignments EvaluationTemplateAssignment[]

  @@unique([name, departmentId])
}

model Location {
  id             String           @id @default(cuid())
  name           String           @unique
  // Morada (rua/número) em linha livre; distrito, concelho e código postal
  // ficam em campos próprios — o concelho é o que liga este local aos
  // feriados regionais (ver Holiday.municipalities).
  address        String?
  postalCode     String?
  municipality   String?
  district       String?
  employees      Employee[]
  operatingHours OperatingHours[]
  createdAt      DateTime         @default(now())
}

// Horário de funcionamento de um departamento ou de um local — usado pela
// geração de escalas para nunca propor turnos fora do horário em que o
// departamento/local está aberto. Uma linha por dia da semana (0=Domingo..
// 6=Sábado) mais uma linha especial para feriados (isHoliday=true,
// dayOfWeek=null, aplica-se a qualquer feriado — ver Holiday). Cada linha
// pertence exclusivamente a um departamento OU a um local, nunca aos dois
// (validado na camada de aplicação, não há CHECK constraint no Postgres).
model OperatingHours {
  id           String      @id @default(cuid())
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  locationId   String?
  location     Location?   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  dayOfWeek    Int? // 0=Domingo..6=Sábado; null quando isHoliday=true
  isHoliday    Boolean     @default(false)
  isClosed     Boolean     @default(false)
  openTime     String? // "HH:MM"
  closeTime    String? // "HH:MM"
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([departmentId, dayOfWeek, isHoliday])
  @@unique([locationId, dayOfWeek, isHoliday])
}

// Feriados configuráveis em Perfis e Acessos → Feriados. Nacionais aplicam-se
// a todos; regionais aplicam-se aos concelhos indicados em `municipalities`
// — um colaborador fica abrangido se o concelho do seu local de trabalho
// (Location.municipality) estiver nessa lista (comparação sem distinguir
// maiúsculas/minúsculas ou espaços, ver isHolidayForMunicipality).
model Holiday {
  id             String   @id @default(cuid())
  date           DateTime
  description    String
  scope          String   @default("NATIONAL") // NATIONAL | REGIONAL
  municipalities String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([date, description])
}

model Employee {
  id     String  @id @default(cuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // Número de colaborador — identificador numérico interno, sem limite de
  // dígitos (guardado como texto só com dígitos para não ficar limitado à
  // gama de um Int/BigInt nem a problemas de serialização de BigInt).
  employeeNumber String? @unique

  // Dados pessoais
  firstName          String
  lastName           String
  email              String    @unique
  phone              String?
  address            String?
  nif                String?   @unique
  idDocument         String?
  idDocumentType     String? // CARTAO_CIDADAO | TITULO_RESIDENCIA | PASSAPORTE | BILHETE_IDENTIDADE
  idDocumentExpiry   DateTime?
  idDocumentNoExpiry Boolean   @default(false) // vitalício
  socialSecurityNo   String?
  iban               String?
  birthDate          DateTime?

  // Dados de identificação adicionais
  idDocumentIssuePlace String? // local de emissão do documento de identificação
  nationality          String?
  educationLevel       String? // ver EDUCATION_LEVELS em lib/employee-constants
  erpCode              String? // código do colaborador no ERP externo (quando aplicável)
  mealCardIban         String? // IBAN do cartão de refeição
  expensesIban         String? // IBAN para reembolso de despesas
  childrenCount        Int?    @default(0) // nº de filhos (informativo — distinto de "dependents", usado no IRS)

  // Contactos
  mobilePhone String? // telemóvel, distinto do telefone fixo (phone)
  locality    String?
  postalCode  String?
  country     String? // país de residência

  // Contacto de emergência
  bloodType              String?
  emergencyContact1Name  String?
  emergencyContact1Phone String?
  emergencyContact2Name  String?
  emergencyContact2Phone String?

  // Dados organizacionais
  jobTitle     String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  teamId       String?
  team         Team?       @relation(fields: [teamId], references: [id])
  locationId   String?
  location     Location?   @relation(fields: [locationId], references: [id])
  managerId    String?
  manager      Employee?   @relation("ManagerReports", fields: [managerId], references: [id])
  reports      Employee[]  @relation("ManagerReports")

  // Especificações para horários
  employmentType   String  @default("FULL_TIME") // FULL_TIME | PART_TIME
  weeklyHours      Float   @default(40)
  availability     String? // JSON: disponibilidade semanal
  restrictions     String? // JSON: restrições (ex.: não domingo)
  shiftPreferences String? // JSON: preferências de turno
  skills           String? // CSV de competências

  status      String    @default("ACTIVE") // ACTIVE | INACTIVE
  hireDate    DateTime?
  importLogId String?

  // Dados de payroll (folha de pagamento)
  maritalStatus String? // NAO_CASADO | CASADO_UNICO_TITULAR | CASADO_DOIS_TITULARES
  dependents    Int     @default(0)
  fiscalRegion  String  @default("CONTINENTE") // CONTINENTE | ACORES | MADEIRA
  // Vencimento base — pertence ao colaborador, não ao contrato: um aumento
  // salarial não implica alterar/criar um novo contrato.
  baseSalary    Float?
  // Subsídio de alimentação (valor e forma de pagamento) é igual para toda
  // a empresa — definido só em PayrollSettings, sem exceção por colaborador.

  // Regime fiscal do IRS Jovem — isenção decrescente por "ano de
  // rendimentos" desde o início do regime (ver IrsYoungExemption).
  youngTaxRegime          Boolean @default(false)
  youngTaxRegimeStartYear Int? // ano civil do 1º ano de benefício

  adseBeneficiary          Boolean @default(false) // só aplicável a entidades da função pública
  judicialDeductionPercent Float? // % de desconto judicial sobre o líquido; vazio = não aplicável

  // Subsídios de férias/Natal — vazio usa a definição global de
  // PayrollSettings; por colaborador pode optar por duodécimos ou por
  // meses concretos (ex.: "6" ou "5,11").
  vacationSubsidyMode    String? // DUODECIMOS | MONTHS
  vacationSubsidyMonths  String? // CSV de meses 1-12, só quando MONTHS
  christmasSubsidyMode   String? // DUODECIMOS | MONTHS
  christmasSubsidyMonths String?

  employeeContracts EmployeeContract[]
  shifts            Shift[]
  absences          Absence[]
  absenceBalances   AbsenceBalance[]
  timeClockEntries  TimeClockEntry[]
  hoursCorrections  HoursCorrection[]
  history           EmployeeHistory[]
  documents         EmployeeDocument[]
  payrollComponents PayrollComponent[]
  payslips          Payslip[]
  tasks             Task[]

  evaluationAssignments EvaluationTemplateAssignment[]
  evaluations           Evaluation[]

  anniversaryComments AnniversaryComment[]

  timeClockDayDecisions TimeClockDayDecision[]
  hourPoolMovements     HourPoolMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeHistory {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  field      String
  oldValue   String?
  newValue   String?
  changedBy  String?
  createdAt  DateTime @default(now())
}

model EmployeeDocument {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name         String // label dado pelo utilizador ao anexo
  type         String // tipo MIME do ficheiro carregado
  fileName     String // nome original do ficheiro
  fileData     String // conteúdo do ficheiro em data URI (base64)
  uploadedById String?
  uploadedAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Módulo de Horários (secção 6)
// ---------------------------------------------------------------------------

model ShiftTemplate {
  id                    String                 @id @default(cuid())
  name                  String                 @unique
  startTime             String // "08:00"
  endTime               String // "16:00"
  breakMins             Int                    @default(0)
  // Hora de início da pausa de refeição deste modelo de turno (ex: "12:00").
  // Para ter o mesmo turno (ex: 09h-18h) com colaboradores a almoçar a
  // horas diferentes, criam-se vários modelos com o mesmo startTime/endTime
  // e breakStart diferente — usado pelo sub-módulo Execução (Escalas) para
  // saber quem está de pausa em cada hora.
  breakStart            String?
  color                 String                 @default("#2563eb")
  shifts                Shift[]
  createdAt             DateTime               @default(now())
  scheduleCyclePatterns ScheduleCyclePattern[]
}

model ScheduleCycle {
  id           String                    @id @default(cuid())
  name         String
  weeks        Int // duração do ciclo em semanas
  startDate    DateTime // data de referência da semana 1
  departmentId String?
  isTemplate   Boolean                   @default(false)
  createdAt    DateTime                  @default(now())
  assignments  ScheduleCycleAssignment[]
  pattern      ScheduleCyclePattern[]

  // Impede nomes duplicados (ex.: cliques repetidos no botão "Criar
  // ciclo") — ciclos e modelos têm namespaces de nome independentes.
  @@unique([name, isTemplate])
}

// padrão do ciclo: para cada semana do ciclo/dia da semana/turno
model ScheduleCyclePattern {
  id              String         @id @default(cuid())
  cycleId         String
  cycle           ScheduleCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  weekIndex       Int // 0-based dentro do ciclo
  dayOfWeek       Int // 0=Domingo .. 6=Sábado
  shiftTemplateId String?
  shiftTemplate   ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id])
  isDayOff        Boolean        @default(false)

  // Impede duas linhas para a mesma célula do padrão (semana/dia) — sem
  // isto, uma condição de corrida ao gravar (dois pedidos quase em
  // simultâneo) podia criar um duplicado que a grelha nunca mostra (só
  // lê a primeira linha) mas que continuava a ser somado no cálculo da
  // média semanal de horas, inflacionando-o silenciosamente.
  @@unique([cycleId, weekIndex, dayOfWeek])
}

model ScheduleCycleAssignment {
  id          String        @id @default(cuid())
  cycleId     String
  cycle       ScheduleCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId  String
  offsetWeeks Int           @default(0) // desfasamento (ex.: equipa B inicia semana 2)
  createdAt   DateTime      @default(now())
}

model Shift {
  id                   String         @id @default(cuid())
  employeeId           String
  employee             Employee       @relation(fields: [employeeId], references: [id])
  date                 DateTime
  startTime            String
  endTime              String
  shiftTemplateId      String?
  shiftTemplate        ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id])
  source               String         @default("MANUAL") // MANUAL | CYCLE | PREDICTIVE
  status               String         @default("DRAFT") // DRAFT | PUBLISHED
  // Um turno publicado é editável (correção pontual), mas fica marcado —
  // a grelha destaca-o com uma cor própria para ficar claro que já não
  // corresponde exatamente ao que foi publicado/notificado ao colaborador.
  editedAfterPublish   Boolean        @default(false)
  notes                String?
  // Alerta de refeição em falta (5h+ sem pausa): timestamp de deteção e,
  // se o colaborador dispensar o lembrete, timestamp da dispensa.
  mealAlertAt          DateTime?
  mealAlertDismissedAt DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([employeeId, date])
}

model DemandForecast {
  id           String   @id @default(cuid())
  departmentId String?
  locationId   String?
  date         DateTime
  hour         Int
  demandValue  Float
  source       String   @default("EXCEL") // EXCEL | API
  importLogId  String?
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Módulo de Picagens (secção 7)
// ---------------------------------------------------------------------------

model TimeClockEntry {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id])
  type             String // CLOCK_IN | CLOCK_OUT | BREAK_START | BREAK_END
  timestamp        DateTime @default(now())
  location         String?
  latitude         Float?
  longitude        Float?
  locationAccuracy Float?

  hasDeviation        Boolean @default(false)
  deviationType       String? // LATE | EARLY_LEAVE | MISSING | OVERTIME
  justification       String?
  justificationStatus String? // PENDING | APPROVED | REJECTED
  reviewedById        String?
  reviewedBy          User?   @relation("DeviationReviewer", fields: [reviewedById], references: [id])

  terminalType String? // WEB | BIOMETRIC | RFID | PIN | MOBILE | OTHER — WEB quando picagem feita na app
  equipmentId  String?
  equipment    Equipment? @relation(fields: [equipmentId], references: [id])

  createdAt DateTime @default(now())

  @@index([employeeId, timestamp])
}

// Equipamento físico de picagem (terminal biométrico, cartão RFID, PIN, etc.)
// associado a uma localização/departamento. webhookToken identifica o
// terminal no endpoint de integração (/api/picagens/webhook/[token]) — cada
// fabricante configura esse URL no respetivo equipamento ou serviço cloud.
model Equipment {
  id           String      @id @default(cuid())
  name         String
  type         String // BIOMETRIC | RFID | PIN | MOBILE | OTHER
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  webhookToken String      @unique @default(cuid())
  apiEndpoint  String? // referência/documentação — endpoint do fabricante para integração por API própria
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())

  // Mapeamento dos nomes de campo que ESTE fabricante usa no JSON do
  // webhook para os 3 dados que são de facto gravados no TimeClockEntry —
  // tudo o resto que o pedido traga fica só como referência, não é gravado.
  payloadEmployeeField  String @default("employeeExternalId")
  payloadTypeField      String @default("type")
  payloadTimestampField String @default("timestamp")

  entries TimeClockEntry[]
}

// Correção manual ao cálculo de horas (execução vs. planeado) — não altera
// as picagens originais, soma-se ao balanço do dia com justificação e
// rasto de auditoria (quem corrigiu e quando).
model HoursCorrection {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  date         DateTime
  // Sempre "ACTUAL" na prática (o previsto vem só da escala, nunca é
  // corrigido) — mantido por compatibilidade com correções antigas.
  field        String   @default("ACTUAL") // ACTUAL | SCHEDULED
  // Corrige o horário real (entrada/saída), não um número de horas —
  // minutesDelta é derivado destas horas e mantido para o cálculo do
  // saldo/payroll continuar a ler um único valor, como antes.
  startTime    String?
  endTime      String?
  minutesDelta Int
  reason       String?
  createdById  String
  createdBy    User     @relation("HoursCorrectionCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Uma correção "ativa" por colaborador/dia/lado — editar uma correção
  // existente substitui-a (upsert), em vez de acumular ajustes que seriam
  // difíceis de rever mais tarde.
  @@unique([employeeId, date, field])
}

// ---------------------------------------------------------------------------
// Módulo de Ausências (secção 8)
// ---------------------------------------------------------------------------

model AbsenceType {
  id                    String           @id @default(cuid())
  name                  String           @unique
  paid                  Boolean          @default(true)
  requiresDocument      Boolean          @default(false)
  unitType              String           @default("WORKING_DAYS") // WORKING_DAYS | CALENDAR_DAYS
  annualLimitDays       Float?
  approvalLevels        Int              @default(1)
  affectsBalance        Boolean          @default(true)
  // Marca o tipo "Férias", gerido pelo módulo dedicado (não pelas Ausências).
  isVacation            Boolean          @default(false)
  // Código de motivo de ausência usado na comunicação à Segurança Social
  // (DMR/plataforma que a substitui) — texto livre, preenchido por RH/
  // contabilidade; a aplicação não valida nem atribui automaticamente.
  socialSecurityCode    String?
  // % do salário normal mantido durante este tipo de ausência: 100 = sem
  // dedução (totalmente pago pela entidade empregadora), 0 = sem
  // remuneração da entidade (ex.: subsídio pago diretamente pela SS), ou
  // um valor intermédio. Usado no cálculo do recibo de vencimento.
  salaryImpactPercent   Float            @default(100)
  // Quando aprovada, uma ausência deste tipo desconta da bolsa de horas do
  // colaborador (ver HourPoolMovement) as horas que estavam previstas em
  // escala para os dias cobertos — ex.: "Compensação de horas".
  countsAgainstHourPool Boolean          @default(false)
  createdAt             DateTime         @default(now())
  absences              Absence[]
  balances              AbsenceBalance[]
}

model Absence {
  id            String      @id @default(cuid())
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id])
  absenceTypeId String
  absenceType   AbsenceType @relation(fields: [absenceTypeId], references: [id])
  startDate     DateTime
  endDate       DateTime
  days          Float
  status        String      @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  reason        String?
  documentName  String?
  // Conteúdo do comprovativo anexado, em data URI (base64) — mesmo padrão
  // de EmployeeDocument.fileData, sem depender de armazenamento externo.
  documentData  String?
  requestedById String
  requestedBy   User        @relation("AbsenceRequester", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?       @relation("AbsenceApprover", fields: [approvedById], references: [id])
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime    @default(now())

  timeClockDayDecisions TimeClockDayDecision[]
  hourPoolMovements     HourPoolMovement[]

  @@index([employeeId, startDate])
}

model AbsenceBalance {
  id            String      @id @default(cuid())
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id])
  absenceTypeId String
  absenceType   AbsenceType @relation(fields: [absenceTypeId], references: [id])
  year          Int
  entitledDays  Float
  // Dias transitados do ano anterior (só relevante para Férias; RH edita).
  carryOverDays Float       @default(0)
  usedDays      Float       @default(0)
  plannedDays   Float       @default(0)

  @@unique([employeeId, absenceTypeId, year])
}

// ---------------------------------------------------------------------------
// Módulo de Avaliação de Desempenho
// ---------------------------------------------------------------------------
// Um modelo (EvaluationTemplate) define perguntas pontuadas (SCALE ou
// SINGLE_CHOICE, cujo maxScore/pontos somam sempre 100 no total) e perguntas
// de texto livre (TEXT, sem pontuação). O resultado de uma Evaluation
// preenchida é sempre a soma das respostas do avaliador (respondent=MANAGER)
// — a autoavaliação (respondent=SELF) é só informativa, nunca entra no
// cálculo nem na consequência.

model EvaluationTemplate {
  id                String   @id @default(cuid())
  name              String
  hasSelfEvaluation Boolean  @default(false)
  createdById       String
  createdBy         User     @relation(fields: [createdById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sections         EvaluationSection[]
  questions        EvaluationQuestion[]
  consequenceRules EvaluationConsequenceRule[]
  assignments      EvaluationTemplateAssignment[]
  evaluations      Evaluation[]
}

// Agrupa perguntas dentro de um modelo (ex.: "Competências técnicas",
// "Comportamento"). Puramente organizacional — não afeta o cálculo.
model EvaluationSection {
  id         String             @id @default(cuid())
  templateId String
  template   EvaluationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  order      Int
  title      String

  questions EvaluationQuestion[]

  @@index([templateId])
}

model EvaluationQuestion {
  id         String             @id @default(cuid())
  templateId String
  template   EvaluationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sectionId  String?
  section    EvaluationSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  order      Int
  text       String
  type       String // SCALE | SINGLE_CHOICE | TEXT
  // Peso da pergunta (0 para TEXT); a soma de SCALE+SINGLE_CHOICE tem de ser
  // exatamente 100 por modelo (validado em lib/evaluations.ts).
  maxScore   Int                @default(0)
  // Só para SCALE: intervalo que o avaliador pode escolher (ex.: 1 a 5). A
  // pontuação atribuída é proporcional: valorEscolhido/scaleMax * maxScore.
  scaleMin   Int?
  scaleMax   Int?

  options EvaluationQuestionOption[]
  answers EvaluationAnswer[]

  @@index([templateId])
  @@index([sectionId])
}

model EvaluationQuestionOption {
  id         String             @id @default(cuid())
  questionId String
  question   EvaluationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  label      String
  points     Int // 0..question.maxScore

  answers EvaluationAnswer[]
}

// Faixas de resultado → consequência (ex.: "a partir de 60%" → "Progressão de
// carreira"). Ao calcular o resultado, escolhe-se a faixa com o maior
// minPercent que ainda seja <= percentagem final.
model EvaluationConsequenceRule {
  id          String             @id @default(cuid())
  templateId  String
  template    EvaluationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  minPercent  Int
  consequence String

  @@index([templateId])
}

// Define quem pode ser avaliado com este modelo — por equipa (todos os
// colaboradores atuais dessa equipa) e/ou por colaborador específico.
model EvaluationTemplateAssignment {
  id         String             @id @default(cuid())
  templateId String
  template   EvaluationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  teamId     String?
  team       Team?              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employeeId String?
  employee   Employee?          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())

  @@index([templateId])
  @@index([teamId])
  @@index([employeeId])
}

// Uma ocorrência agendada/realizada de um modelo para um colaborador.
model Evaluation {
  id            String             @id @default(cuid())
  templateId    String
  template      EvaluationTemplate @relation(fields: [templateId], references: [id])
  employeeId    String
  employee      Employee           @relation(fields: [employeeId], references: [id])
  scheduledDate DateTime
  status        String             @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED
  createdById   String
  createdBy     User               @relation("EvaluationCreatedBy", fields: [createdById], references: [id])

  managerCompletedAt   DateTime?
  managerCompletedById String?
  managerCompletedBy   User?     @relation("EvaluationCompletedBy", fields: [managerCompletedById], references: [id])
  managerScore         Int?
  managerPercent       Int?
  managerConsequence   String?

  selfCompletedAt DateTime?
  selfScore       Int?
  selfPercent     Int?

  answers EvaluationAnswer[]
  tasks   Task[]

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([status, scheduledDate])
}

model EvaluationAnswer {
  id               String                    @id @default(cuid())
  evaluationId     String
  evaluation       Evaluation                @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  questionId       String
  question         EvaluationQuestion        @relation(fields: [questionId], references: [id])
  respondent       String // MANAGER | SELF
  score            Int?
  // Só para SCALE: o valor bruto escolhido pelo avaliador dentro de
  // [question.scaleMin, question.scaleMax], antes da conversão para pontos.
  rawValue         Int?
  selectedOptionId String?
  selectedOption   EvaluationQuestionOption? @relation(fields: [selectedOptionId], references: [id])
  textValue        String?

  @@unique([evaluationId, questionId, respondent])
}

// ---------------------------------------------------------------------------
// Módulo de Contratos de Trabalho (secção 9)
// ---------------------------------------------------------------------------

// Lista de tipos de contrato configurável (tal como RoleDefinition para os
// perfis) — os 5 tipos originais vêm marcados isSystem (não podem ser
// apagados, o código depende do valor "PART_TIME"), mas o Administrador
// pode adicionar outros tipos específicos da empresa.
model ContractTypeDefinition {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Perfil de contrato partilhado e nomeado — os termos (tipo, horas/semana,
// descanso semanal, fins de semana/feriados) não são editáveis depois de
// criado; só o nome e o estado ativo/inativo. Um perfil só pode ser
// inativado se não tiver nenhum colaborador atualmente atribuído (ver
// EmployeeContract).
model ContractProfile {
  id             String   @id @default(cuid())
  name           String   @unique
  contractType   String // SEM_TERMO | TERMO_CERTO | TERMO_INCERTO | PRESTACAO_SERVICOS | PART_TIME
  weeklyHours    Float
  // Descanso semanal mínimo exigido pelo contrato (dias/semana) — usado para
  // validar o padrão de ciclos de horário contra o art.º 205.º do Código do
  // Trabalho (mínimo legal: 1).
  weeklyRestDays Int      @default(1)
  // Se o colaborador pode ser escalado a trabalhar aos fins de semana /
  // feriados (nacionais e regionais, consoante o local de trabalho) — tanto
  // na criação manual de turnos como na geração automática de escalas.
  worksWeekends  Boolean  @default(true)
  worksHolidays  Boolean  @default(true)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignments EmployeeContract[]
}

// Atribuição imutável de um perfil de contrato a um colaborador — cada
// atribuição fica registada para sempre no histórico do colaborador
// (nunca é editada nem apagada, só encerrada via `status`/`endDate`).
model EmployeeContract {
  id                 String          @id @default(cuid())
  employeeId         String
  employee           Employee        @relation(fields: [employeeId], references: [id])
  contractProfileId  String
  contractProfile    ContractProfile @relation(fields: [contractProfileId], references: [id])
  startDate          DateTime
  endDate            DateTime?
  trialPeriodEndDate DateTime?
  notes              String?
  status             String          @default("ACTIVE") // ACTIVE | ENDED
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

// ---------------------------------------------------------------------------
// Módulo de Payroll (Processamento Salarial)
// ---------------------------------------------------------------------------
// Nota: os valores por omissão (salário mínimo, taxas, escalões de IRS) são
// uma aproximação configurável, não uma cópia certificada das tabelas
// oficiais da Autoridade Tributária — devem ser revistos/ajustados por RH.

model PayrollSettings {
  id                         String   @id @default(cuid())
  minimumWage                Float    @default(870)
  socialSecurityEmployeeRate Float    @default(0.11)
  socialSecurityEmployerRate Float    @default(0.2375)
  workAccidentInsuranceRate  Float    @default(0.01)
  mealAllowanceDaily         Float    @default(6)
  overtimeRateFirstHour      Float    @default(1.25)
  overtimeRateAdditional     Float    @default(1.375)
  overtimeRateWeekendHoliday Float    @default(1.5)
  workingDaysPerMonth        Float    @default(22)
  vacationSubsidyMode        String   @default("LUMP_SUM_JUNE") // LUMP_SUM_JUNE | MONTHLY_DUODECIMOS
  christmasSubsidyMode       String   @default("LUMP_SUM_DECEMBER") // LUMP_SUM_DECEMBER | MONTHLY_DUODECIMOS
  mealAllowancePaymentMethod String   @default("CARD") // CARD | CASH — define qual o limite diário de isenção fiscal a aplicar
  adseEmployeeRate           Float    @default(0.035) // quota do trabalhador beneficiário ADSE, sobre o vencimento base
  updatedAt                  DateTime @updatedAt
  updatedById                String?
}

// Uma tabela de retenção na fonte de IRS — os escalões oficiais variam por
// período (ano), por região (Continente/Açores/Madeira) e por tabela
// (I = não casado sem dependentes/casado dois titulares, II = não casado
// com dependentes, III = casado único titular). RH anexa/atualiza uma
// tabela por combinação período+região+tabela; o cálculo do recibo
// escolhe a tabela certa pelo ano do recibo, pela região fiscal e pelo
// estado civil/nº de dependentes do colaborador.
model IrsTable {
  id        String       @id @default(cuid())
  year      Int
  // Portugal pode publicar mais do que uma tabela de IRS no mesmo ano (ex.:
  // uma atualização a meio do ano) — monthFrom/monthTo (1-12, inclusive)
  // definem o intervalo de meses em que esta tabela se aplica dentro do
  // ano. Por omissão cobre o ano inteiro (1-12).
  monthFrom Int          @default(1)
  monthTo   Int          @default(12)
  region    String       @default("CONTINENTE") // CONTINENTE | ACORES | MADEIRA
  tableType String       @default("I") // I | II | III — ver IRS_TABLE_TYPE_LABELS
  label     String? // ex.: "Não casado sem dependentes / casado dois titulares"
  brackets  IrsBracket[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([year, region, tableType, monthFrom])
}

// Escalões progressivos de uma tabela de IRS — taxa marginal aplicada ao
// valor bruto tributável do mês, menos a parcela a abater e o adicional
// por dependente. Nos primeiros escalões (mesmo acima do limite de
// isenção), a Autoridade Tributária usa uma fórmula dinâmica em vez de uma
// parcela fixa — deductionCoefficient/deductionThreshold, quando
// preenchidos, substituem "deduction": parcela = rate * coef * (threshold
// - rendimentoTributável).
model IrsBracket {
  id                   String   @id @default(cuid())
  irsTableId           String
  irsTable             IrsTable @relation(fields: [irsTableId], references: [id], onDelete: Cascade)
  order                Int
  upToGross            Float? // null = sem limite superior (último escalão)
  rate                 Float // taxa marginal (ex.: 0.145 = 14.5%)
  deduction            Float? // parcela a abater (€) — null quando usa fórmula dinâmica
  deductionCoefficient Float? // fórmula dinâmica dos escalões baixos (ver comentário do modelo)
  deductionThreshold   Float?
  dependentAddition    Float    @default(0) // acréscimo por dependente (€)

  @@unique([irsTableId, order])
}

// Percentagem de isenção do regime do IRS Jovem por "ano de rendimentos"
// desde o início do regime (1º ano = 100%, 2º-4º = 75%, etc.) — a lei
// pode alterar estes valores por ano fiscal, por isso ficam por período
// tal como as tabelas de IRS normais.
model IrsYoungExemption {
  id               String @id @default(cuid())
  year             Int
  yearOfBenefit    Int // 1..10
  exemptionPercent Float // 1.00 = 100%

  @@unique([year, yearOfBenefit])
}

// Constantes fiscais que mudam todos os anos e não são específicas de
// nenhuma tabela de IRS — IAS (usado no teto de isenção do IRS Jovem) e os
// limites diários de isenção do subsídio de alimentação (cartão vs.
// transferência/numerário, valores diferentes por lei).
model FiscalYearConstants {
  id                                String   @id @default(cuid())
  year                              Int      @unique
  ias                               Float // Indexante dos Apoios Sociais
  mealAllowanceExemptCardDaily      Float    @default(10.60)
  mealAllowanceExemptCashDaily      Float    @default(6.60)
  youngExemptionCapAnnualMultiplier Float    @default(55) // × IAS
  youngExemptionCapPaymentsPerYear  Float    @default(14) // ÷ nº pagamentos/ano (12 meses + 2 subsídios)
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt
}

// Layout do recibo de vencimento (PDF e pré-visualização no ecrã) —
// permite a RH escolher que linhas aparecem, com que texto e por que
// ordem, sem tocar em código. `lineItemsJson` guarda um array ordenado de
// { key, label, visible } por secção (ver PAYSLIP_LINE_ITEMS em
// src/lib/payroll.ts para as chaves disponíveis).
model PayslipLayoutSettings {
  id            String   @id @default(cuid())
  documentTitle String   @default("Recibo de Vencimento")
  footerNote    String?
  lineItemsJson String
  updatedAt     DateTime @updatedAt
  updatedById   String?
}

// Componentes variáveis por colaborador (prémios, subsídios específicos,
// descontos pontuais ou recorrentes) que entram no cálculo do recibo.
model PayrollComponent {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name         String
  type         String // EARNING | DEDUCTION
  amount       Float
  recurring    Boolean  @default(true)
  taxable      Boolean  @default(true)
  ssApplicable Boolean  @default(true)
  applyYear    Int? // obrigatório quando recurring = false
  applyMonth   Int? // 1-12, obrigatório quando recurring = false
  createdAt    DateTime @default(now())
}

// Recibo de vencimento gerado (ficam "congelados" após gerados).
model Payslip {
  id                     String    @id @default(cuid())
  employeeId             String
  employee               Employee  @relation(fields: [employeeId], references: [id])
  year                   Int
  month                  Int
  baseSalary             Float
  workedHours            Float
  workedDays             Float     @default(0)
  overtimeHours          Float
  overtimePay            Float
  mealAllowanceTotal     Float
  mealAllowanceExempt    Float
  absenceDeductionDays   Float
  absenceDeduction       Float
  otherEarnings          Float
  otherDeductions        Float
  // Cada rubrica variável (PayrollComponent) individual deste recibo, tal
  // como estava no momento da geração — para que o recibo mostre "Prémio:
  // 100€" e "Seguro de saúde: 20€" em vez de um "Outros vencimentos"
  // agregado, mesmo que a rubrica original seja editada/apagada depois.
  // JSON: { name, type, amount, category }[]
  componentsJson         String?
  vacationSubsidy        Float     @default(0)
  christmasSubsidy       Float     @default(0)
  grossTotal             Float
  socialSecurityEmployee Float
  irsWithholding         Float
  adseDeduction          Float     @default(0)
  judicialDeduction      Float     @default(0)
  netTotal               Float
  socialSecurityEmployer Float
  employerCost           Float
  belowMinimumWage       Boolean   @default(false)
  generatedAt            DateTime  @default(now())
  generatedById          String?
  // "Gerar novamente" (ver GeneratePayslipButton) não altera generatedAt/
  // generatedById (a 1ª geração) — regista aqui a data/utilizador da
  // última regeneração e quantas vezes já foi regenerado.
  regeneratedAt          DateTime?
  regeneratedById        String?
  regenerationCount      Int       @default(0)
  emailSentAt            DateTime?

  @@unique([employeeId, year, month])
}

// ---------------------------------------------------------------------------
// Integrações (secção 6.4 / CD)
// ---------------------------------------------------------------------------

model ImportLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  type        String // EMPLOYEES | DEMAND | SCHEDULE
  fileName    String
  status      String // SUCCESS | ERROR | PARTIAL | REVERTED
  totalRows   Int      @default(0)
  errorRows   Int      @default(0)
  errorReport String?
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Subscrição de módulos (linha única, tal como PayrollSettings) — permite
// desligar módulos avançados ainda não contratados/à medida para este
// cliente, mostrando um estado vazio explicativo em vez do módulo.
// ---------------------------------------------------------------------------

model ModuleSubscription {
  id                        String   @id @default(cuid())
  predictiveEnabled         Boolean  @default(false)
  // Aniversários de entrada (dinâmica social no dashboard, à semelhança dos
  // aniversários de nascimento) — o Administrador do Sistema pode desligar
  // só esta parte, mantendo os aniversários de nascimento ativos.
  workAnniversaryEnabled    Boolean  @default(true)
  // Margem de segurança (minutos) para o saldo diário de picagens — abaixo
  // disto o dia não precisa de correção/justificação; acima, o gestor de
  // RH tem de decidir o que fazer ao desvio (ver TimeClockDayDecision).
  timeClockToleranceMinutes Int      @default(15)
  updatedAt                 DateTime @updatedAt
  updatedById               String?
}

// Decisão do gestor de RH sobre o desvio (real vs. previsto) de um dia de
// picagens, quando esse desvio ultrapassa a margem de segurança
// (ModuleSubscription.timeClockToleranceMinutes). Uma por colaborador/dia —
// voltar a decidir substitui a anterior (upsert).
model TimeClockDayDecision {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  date         DateTime
  // Desvio (real - previsto, em minutos) no momento da decisão.
  diffMinutes  Int
  // DEDUCTION  = injustificado e |desvio| > 1h → desconto em payroll
  // POOL       = injustificado ≤ 1h, ou explicitamente para a bolsa de horas
  // JUSTIFIED  = coberto por uma ausência aprovada (absenceId)
  // OVERTIME   = desvio positivo reconhecido como hora extra → payroll
  decisionType String
  absenceId    String?
  absence      Absence? @relation(fields: [absenceId], references: [id])
  createdById  String
  createdBy    User     @relation("TimeClockDayDecisionCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([employeeId, date])
}

// Bolsa de horas (banco de horas) de um colaborador — ledger de créditos e
// débitos. Alimentada por decisões de picagens (POOL) e por ausências cujo
// tipo desconta da bolsa (AbsenceType.countsAgainstHourPool). O gestor de
// RH pode anular um movimento (fica marcado reversedAt/reversedById, sem
// apagar o histórico).
model HourPoolMovement {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  date         DateTime
  minutes      Int // positivo = crédito, negativo = débito
  source       String // TIME_CLOCK | ABSENCE
  reason       String?
  absenceId    String?
  absence      Absence?  @relation(fields: [absenceId], references: [id])
  createdById  String
  createdBy    User      @relation("HourPoolMovementCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  reversedAt   DateTime?
  reversedById String?
  reversedBy   User?     @relation("HourPoolMovementReversedBy", fields: [reversedById], references: [id])

  @@index([employeeId, date])
}

// Mensagem de aniversário (nascimento ou entrada na empresa) deixada por um
// colega — é um "postal" privado: só o próprio colaborador homenageado
// consegue ler as mensagens que recebeu (ver getMyAnniversaryMessages).
// Um colega só pode deixar uma mensagem por pessoa/ocasião/ano — voltar a
// comentar no mesmo ano substitui a mensagem anterior.
model AnniversaryComment {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  kind       String // BIRTHDAY | WORK_ANNIVERSARY
  year       Int
  body       String
  createdAt  DateTime @default(now())

  @@unique([employeeId, authorId, kind, year])
  @@index([employeeId, kind, year])
}

// Identidade visual usada no cabeçalho dos documentos para download (ex.:
// PDF de escalas): people4people fica sempre à esquerda (fixo no código);
// a informação da empresa cliente à direita é o que este registo guarda.
model DocumentBrandingSettings {
  id                      String   @id @default(cuid())
  clientCompanyName       String?
  clientCompanyLogo       String? // data URI (base64), como o avatar de utilizador
  companyNif              String? // contribuinte da entidade empregadora
  companyAddress          String? // morada da sede, para o cabeçalho de documentos (ex.: recibo de vencimento)
  companySocialSecurityNo String? // nº de identificação da SS da entidade empregadora
  updatedAt               DateTime @updatedAt
  updatedById             String?
}

// Modelo de documento para exportação (Relatórios → Modelos de Documentos):
// composto por blocos ordenados (cabeçalho/logótipo, texto livre, tabela de
// um relatório existente, grelha de escala mensal, área de assinatura).
// Cada bloco só mostra dados já existentes (relatórios/escala) — não há
// campos calculados no modelo, tal como o editor de layout do recibo de
// vencimento (mesma ideia: blocksJson guarda DocumentBlock[]).
model DocumentTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  blocksJson  String   @default("[]")
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
